<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_create_nextcloud_folder" model="ir.cron">
            <field name="name">Training Certificate: create nextcloud folder</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="model_id" ref="model_res_partner"/>
            <field name="active" eval="True"/>
            <field name="code">model._add_nextcloud_folder()</field>
            <field name="state">code</field>
            <field name="nextcall" eval="(DateTime.now().replace(day=1) + timedelta(days=32)).strftime('%Y-%m-01 01:00:00')" />
        </record>
    </data>
</odoo>