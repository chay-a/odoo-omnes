<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="training_year_action" model="ir.actions.act_window">
        <field name="name">Training Year</field>
        <field name="res_model">training_year</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="training_year_tree" model="ir.ui.view">
        <field name="name">training_year.list</field>
        <field name="model">training_year</field>
        <field name="arch" type="xml">
                <list string="Training Year">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
        </field>
    </record>
</odoo>