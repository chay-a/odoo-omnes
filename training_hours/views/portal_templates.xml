<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <template id="portal_my_home_training"
              name="Portal : Training"
              inherit_id="portal.portal_my_home"
              priority="20">
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Training</t>
                <t t-set="url" t-value="'/my/training_hours'"/>
<!--                <t-->
<!--                    t-set="icon"-->
<!--                    t-value="'/membership_portal/static/icons/portal_icon.svg'"-->
<!--                />-->
                <t t-set="text">View your training hours</t>
                <t t-set="placeholder_count">1</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>
    <template
        id="portal_my_training_breadcrumbs"
        name="My Training: Breadcrumbs"
        inherit_id="portal.portal_breadcrumbs"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <t t-if="page == 'my_training_hours'">
                <li class="breadcrumb-item active">
                    Training
                </li>
            </t>
        </xpath>
    </template>
    <template id="portal_my_training" name="My Training">
        <t t-call="portal.portal_layout">
            <div class="o_portal_index_card col-12 order-0 container">
                <div class="d-flex gap-3 align-items-center mb-3 flex-wrap">
                    <h1 class="m-0">Trainings</h1>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#TrainingCreateFormModal">Add</button>
                    <div class="modal fade" id="TrainingCreateFormModal" tabindex="-1" role="dialog" aria-labelledby="TrainingCreateFormModalTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="trainingCreateTitle">Add new training time</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <form id="training-create-form" method="POST" action="/my/training/new" enctype="multipart/form-data">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <div class="d-flex gap-1 align-items-center">
                                                <label for="organisation" class="form-label">Organisation <span class="text-danger">*</span></label>
                                                <i class="fa fa-question-circle text-primary form-label" aria-hidden="true" data-bs-toggle="tooltip" title="Training organisation (must be written on the certificate)"/>
                                            </div>
                                            <input type="text" name="organisation" class="form-control" id="organisation" required="true"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Type <span class="text-danger">*</span></label>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="type" id="lifelong_learning" value="lifelong_learning" checked="True"/>
                                                <label class="form-check-label" for="lifelong_learning">
                                                    Lifelong Learning
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="type" id="initial_learning" value="initial_learning"/>
                                                <label class="form-check-label" for="initial_learning">
                                                    Initial Learning
                                                </label>
                                            </div>
                                        </div>
                                        <div class="mb-3">
                                            <div class="d-flex gap-1 align-items-center">
                                                <label for="hours" class="form-label">Hours <span class="text-danger">*</span></label>
                                                <i class="fa fa-question-circle text-primary form-label" aria-hidden="true" data-bs-toggle="tooltip" title="Must be written on the certificate"/>
                                            </div>
                                            <input type="float" name="hours" class="form-control" id="hours" step="0.1" min="0" required="true"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="year_id" class="form-label">Choose year <span class="text-danger">*</span></label>
                                            <select id="year_id" name="year_id" class="form-select" aria-label="Default select example" required="true">
                                                <option value="" disabled="true" selected="true">Select your option</option>
                                                <option t-foreach="training_years" t-as="year" t-key="year.id" t-att-value="year.id">
                                                    <t t-esc="year.name" />
                                                </option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="training_technique_ids" class="form-label">Technique <span class="text-danger">*</span></label>
                                            <select id="training_technique_ids" name="training_technique_ids" class="form-select" aria-label="Default select example" required="true">
                                                <option value="" disabled="true" selected="true">Select your option</option>
                                                <option t-foreach="training_techniques" t-as="technique" t-key="technique.id" t-att-value="technique.id">
                                                    <t t-esc="technique.name" />
                                                </option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <div class="d-flex gap-1 align-items-center">
                                                <label for="file" class="form-label">Certificate <span class="text-danger">*</span></label>
                                                <i class="fa fa-question-circle text-primary form-label" aria-hidden="true" data-bs-toggle="tooltip" title="Authorised extensions: .pdf, .png, .jpg, .jpeg; Max size : 2MB"/>
                                            </div>
                                            <input type="file" name="file" class="form-control" id="file" required="true" accept=".pdf,.png,.jpg,.jpeg"/>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <input type="submit" class="btn btn-primary" form="training-create-form" value="Save"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between flex-wrap mb-3">
                    <p class="fs-3">Total hours: <span class="fw-bold" t-out="total_hours" /></p>
                    <owl-component name="training_hours.YearFilter"
                               t-att-props="json.dumps(year_filter_props)"/>
                </div>
                <div class="row gap-3 justify-content-center">
                    <t t-foreach="training_sessions" t-as="training">
                        <div class="col-11 col-sm-5 col-md-3 border border-gray-100 rounded-2 d-flex- flex-column align-items-center p-2">
                            <p t-out="training.organisation" class="text-truncate text-uppercase" t-att-title="training.organisation"/>
                            <div class="d-flex gap-1 text-primary">
                                <p t-field="training.hours" t-options="{'widget': 'float_time'}"/>
                            </div>
                            <p t-out="training.training_technique_ids.name" class="mb-0 text-truncate text-uppercase" t-att-title="training.training_technique_ids.name"/>
                            <owl-component name="training_hours.DeleteButton" t-att-props="json.dumps({'deleteURL': '/my/training/delete/','trainingId': training.id})"/>
                        </div>
                    </t>
                </div>
                <div class="training_pager form-inline justify-content-center mt-3 d-flex">
                    <t t-call="website.pager">
                    <t t-set="_classes">mt-2 ml-md-2</t>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>