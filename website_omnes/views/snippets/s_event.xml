<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="dynamic_filter_template_event_event_picture"
              inherit_id="website_event.dynamic_filter_template_event_event_picture">
        <xpath expr="//div[@t-foreach='records']/a/div/time" position="replace">
            <div class="d-flex gap-1 mx-auto">
                <time t-att-datetime="record.date_begin" class="text-white">
                    <span t-out="record.date_begin"
                          t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'long', 'tz_name': record.date_tz}"/>
                </time>
                <span class="text-white"> - </span>
                <time t-att-datetime="record.date_begin" class="text-white">
                    <span t-out="record.date_end"
                          t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'long', 'tz_name': record.date_tz}"/>
                </time>
            </div>
        </xpath>
    </template>
    <template id="dynamic_filter_template_event_event_card" inherit_id="website_event.dynamic_filter_template_event_event_card">
        <xpath expr="//div[@t-if='events_event_time_active']" position="replace">
            <div t-if="events_event_time_active" class="s_events_event_time mb-1 small fw-bold">
                <span t-out="record.date_end" t-options="{'widget': 'datetime', 'date_only': 'true', 'format': 'long', 'tz_name': record.date_tz}"/>
            </div>
        </xpath>
    </template>
</odoo>
