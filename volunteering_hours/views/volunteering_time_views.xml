<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="volunteering_time_action" model="ir.actions.act_window">
        <field name="name">Volunteering time</field>
        <field name="res_model">volunteering_time</field>
        <field name="view_mode">list,form</field>
    </record>
     <record id="volunteering_time_tree" model="ir.ui.view">
            <field name="name">volunteering_time.list</field>
            <field name="model">volunteering_time</field>
            <field name="arch" type="xml">
                    <list string="Volunteering Times">
                        <field name="action_id"/>
                        <field name="place_id"/>
                        <field name="date"/>
                    </list>
            </field>
     </record>
</odoo>