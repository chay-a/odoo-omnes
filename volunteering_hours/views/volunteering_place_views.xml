        <field name="name">Volunteering Place</field>
        <field name="res_model">volunteering_place</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="volunteering_place_tree" model="ir.ui.view">
        <field name="name">volunteering_place.list</field>
