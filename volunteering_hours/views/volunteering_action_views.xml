<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="volunteering_action_action" model="ir.actions.act_window">
        <field name="name">Volunteering Action</field>
        <field name="res_model">volunteering_action</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="volunteering_action_tree" model="ir.ui.view">
        <field name="name">volunteering_action.list</field>
        <field name="model">volunteering_action</field>
        <field name="arch" type="xml">
                <list string="Volunteering Actions">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                </list>
        </field>
    </record>
</odoo>