<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_volunteering"
              name="Portal : Volunteering"
              inherit_id="portal.portal_my_home"
              priority="20">
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Volunteering</t>
                <t t-set="url" t-value="'/my/volunteering'"/>
<!--                <t-->
<!--                    t-set="icon"-->
<!--                    t-value="'/membership_portal/static/icons/portal_icon.svg'"-->
<!--                />-->
                <t t-set="text">View your volunteering hours</t>
                <t t-set="placeholder_count">1</t>
                <t t-set="config_card" t-value="True"/>
            </t>
        </div>
    </template>
    <template
        id="portal_my_volunteering_breadcrumbs"
        name="My Volunteering: Breadcrumbs"
        inherit_id="portal.portal_breadcrumbs"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li class="breadcrumb-item active">
                Volunteering
            </li>
        </xpath>
    </template>
    <template id="portal_my_volunteering" name="My Volunteering">
        <t t-call="portal.portal_layout">
            <div class="o_portal_index_card col-12 order-0 container">
                <div class="d-flex gap-3 align-items-center mb-3 flex-wrap">
                    <h1 class="m-0">Volunteering Times</h1>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#VolunteeringCreateFormModal">Add</button>
                    <div class="modal fade" id="VolunteeringCreateFormModal" tabindex="-1" role="dialog" aria-labelledby="VolunteeringCreateFormModalTitle" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="volunteeringCreateTitle">Add new volunteering time</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                                </div>
                                <div class="modal-body">
                                    <form id="volunteering-create-form" method="POST" action="/my/volunteering/new">
                                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                        <div class="mb-3">
                                            <div class="d-flex gap-1 align-items-center">
                                                <label for="date" class="form-label">Date <span class="text-danger">*</span></label>
                                                <i class="fa fa-question-circle text-primary form-label" aria-hidden="true" data-bs-toggle="tooltip" title="Date of the event, or the first day"/>
                                            </div>
                                            <input type="date" name="date" class="form-control" id="date" required="true"/>
                                        </div>
                                        <div class="mb-3">
                                            <label for="action_id" class="form-label">Object of the action <span class="text-danger">*</span></label>
                                            <select id="action_id" name="action_id" class="form-select" aria-label="Default select example" required="true">
                                                <option value="" disabled="true" selected="true">Select your option</option>
                                                <option t-foreach="volunteering_actions" t-as="action" t-key="action.id" t-att-value="action.id">
                                                    <t t-esc="action.complete_name" />
                                                </option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label for="place_id" class="form-label">Place <span class="text-danger">*</span></label>
                                            <select id="place_id" name="place_id" class="form-select" aria-label="Default select example" required="true">
                                                <option value="" disabled="true" selected="true">Select your option</option>
                                                <option t-foreach="volunteering_places" t-as="place" t-key="place.id" t-att-value="place.id">
                                                    <t t-esc="place.name" />
                                                </option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <div class="d-flex gap-1 align-items-center">
                                                <label for="hours" class="form-label">Hours <span class="text-danger">*</span></label>
                                                <i class="fa fa-question-circle text-primary form-label" aria-hidden="true" data-bs-toggle="tooltip" title="Value must be a decimal ex. 2.5 = 2h30, 3 = 3h, 1.75 = 1h45"/>
                                            </div>
                                            <input type="float" name="hours" class="form-control" id="hours" step="0.1" min="0" required="true"/>
                                        </div>
                                    </form>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <input type="submit" class="btn btn-primary" form="volunteering-create-form" value="Save"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-between flex-wrap mb-3">
                    <p class="fs-3">Total hours: <span class="fw-bold" t-out="total_hours" /></p>
                    <owl-component name="volunteering_hours.YearFilter"
                               t-att-props="json.dumps(year_filter_props)"/>
                </div>
                <div class="row gap-3 justify-content-center">
                    <t t-foreach="volunteering_times" t-as="volunteering">
                        <div class="col-11 col-sm-5 col-md-3 border border-gray-100 rounded-2 d-flex- flex-column align-items-center p-2">
                            <p t-out="volunteering.action_id.name" class="text-truncate text-uppercase" t-att-title="volunteering.action_id.name"/>
                            <div class="d-flex gap-1 text-primary">
                                <p t-field="volunteering.date"/>
                                <span> - </span>
                                <p t-field="volunteering.hours" t-options="{'widget': 'float_time'}"/>
                            </div>
                            <p t-out="volunteering.place_id.name" class="mb-0"/>
                            <owl-component name="volunteering_hours.DeleteButton" t-att-props="json.dumps({'deleteURL': '/my/volunteering','volunteeringYear': volunteering.date.year, 'volunteeringId': volunteering.id, 'currentYear':currentYear})"/>
                        </div>
                    </t>
                    <div class="volunteering_pager form-inline justify-content-center mt-3 d-flex">
                        <t t-call="website.pager">
                        <t t-set="_classes">mt-2 ml-md-2</t>
                        </t>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>