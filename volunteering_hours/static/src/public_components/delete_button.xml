<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="volunteering_hours.DeleteButton">
        <div class="d-grid mt-2">
            <button
                    type="button"
                    t-attf-class="btn btn-sm rounded-1 {{props.volunteeringYear == props.currentYear ? 'btn-outline-danger' : 'btn-outline-grey'}}"
                    t-att-disabled="props.volunteeringYear != props.currentYear"
                    t-att-style="props.volunteeringYear != props.currentYear ? 'pointer-events: visible;' : ''"
                    t-att-title="props.volunteeringYear == props.currentYear ? 'Delete' : 'Cannot delete sessions from past years'"
                    t-att-data-volunteering_id="props.volunteeringId"
                    t-on-click="onDelete"
            >Delete</button>
        </div>
    </t>
</templates>